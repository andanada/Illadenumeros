# Mates Màgiques API — configuración. Copia este archivo a `.env` (chmod 600) y rellena los dos secretos.
# Nada de aquí se sube a git: `.env` está en .gitignore.

NODE_ENV=production
HOST=0.0.0.0              # dentro del contenedor; compose publica solo en 127.0.0.1
PORT=3100
DATABASE_PATH=/data/mates.db
LOG_LEVEL=info

# --- SECRETOS (obligatorios en producción) ---
# Sal para el hash de las IP del registro de auditoría. Mínimo 32 caracteres: openssl rand -hex 32
IP_HASH_SALT=
# Código de invitación para crear cuentas. Mínimo 20 caracteres: openssl rand -base64 24
# Si está vacío el registro queda CERRADO.
REGISTRATION_CODE=

# --- Detrás de nginx ---
SESSION_COOKIE_SECURE=true
# Gateway fijo de la red de docker compose (172.30.100.1): solo de ahí se acepta X-Forwarded-For.
TRUST_PROXY=172.30.100.1

# --- Contraseñas (argon2id; mínimos de OWASP) ---
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Sesiones y bloqueo de inicio de sesión ---
SESSION_TTL_DAYS=30
SESSION_MAX_DAYS=90
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_EMAIL_MAX_FAILURES=30

# --- Límites de peticiones (por minuto) ---
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SYNC=60
RATE_LIMIT_PROFILE=30

# --- Cuotas por perfil ---
QUOTA_DOCS_PER_PROFILE=2000
QUOTA_ATTEMPTS_PER_PROFILE=200000

# --- Retención ---
PURGE_AFTER_DAYS=30
AUDIT_RETENTION_DAYS=90
